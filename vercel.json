{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/generate-text", "dest": "/api/generate-text.py" },
    { "src": "/api/generate-image-prompt", "dest": "/api/generate-image-prompt.py" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
